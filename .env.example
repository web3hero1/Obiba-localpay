# ==============================================================================
# OBIBA LOCALPAY — ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# 1. Supabase PostgreSQL & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# 2. NEAR Intents 1Click API (Defuse Protocol)
NEXT_PUBLIC_NEAR_INTENTS_API=https://1click.chaindefuser.com
NEAR_INTENTS_JWT_TOKEN=optional-jwt-token-for-authenticated-rfq

# 3. Environment & Execution Mode
NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=hackathon-sandbox # set to 'production' for live mainnet custody

# 4. Obiba Custody & Treasury
OOB_SETTLEMENT_VAULT_ADDRESS=obiba-settlement.near
OOB_BASE_FX_RATE_GHS_PER_USDC=15.25
